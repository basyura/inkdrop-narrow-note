{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": false,
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@inkdropapp/types", "node", "react"]
  },
  "include": ["lib/**/*.js"]
}
